<!DOCTYPE html>
<html>
<head>
    <title>Dashboard</title>
</head>
<body>
    <h2>ยินดีต้อนรับสู่ Dashboard</h2>
    <p>นี่คือข้อมูลทั้งหมดในระบบ:</p>
    <ul>
        <% records.forEach(function(item) { %>
            <li>ID: <%= item.id %> | Name: <%= item.name %> | Status: <%= item.status %></li>
        <% }); %>
    </ul>
</body>
</html>